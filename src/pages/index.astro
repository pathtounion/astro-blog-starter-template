---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Path To Union</h1>
			<p>
				The mission of Path To Union is to provide signposts
                                on the path to a healthy body and mind and understanding
                                of the human condition and the meaning of life.
			</p>
		</main>
		<Footer />
	</body>
</html>
