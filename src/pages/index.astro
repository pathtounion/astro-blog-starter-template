---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Path To Union</h1>
			<p>
				The mission of Path To Union is to guide humans
                                on a path to a healthy body and mind, provide an
                                understanding of life, consciousness, and the human
                                condition, and support individual human self-realization.
			</p>
			<p>
                                You are not a drop in the ocean. You are the entire ocean in a drop.
                                Rumi 1207-1273
			</p>
		</main>
		<Footer />
	</body>
</html>
